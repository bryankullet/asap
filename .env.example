# =============================================================================
# ASAP — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# See docs/SECRETS.md for where each value comes from and how to rotate it.
#
# Every variable is parsed through the Zod schema in packages/schema/src/env.ts.
# A missing required variable stops the process naming the variable.
# Only variables prefixed VITE_PUBLIC_ reach the browser bundle.
#
# Domains: real domains are not decided yet. Placeholders below are marked
# "REAL-DOMAIN" so they can be found with: grep -rn REAL-DOMAIN .
#   local       asap.local            (dev only; the Vite/Hono ports are the real address)
#   staging     staging.asap.example  REAL-DOMAIN
#   production  app.asap.example      REAL-DOMAIN
# =============================================================================

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development                  # development | test | production
APP_ENV=local                         # local | staging | production
LOG_LEVEL=debug                       # debug | info | warn | error

API_PORT=8787
API_BASE_URL=http://localhost:8787    # staging: https://api.staging.asap.example  REAL-DOMAIN
# Server-only. Lets the API write work items, runs and drafts (0023). >= 32 chars. The API registers its hash itself on boot (0025).
API_INTERNAL_KEY=
WEB_BASE_URL=http://localhost:5173    # staging: https://staging.asap.example      REAL-DOMAIN

# --- Supabase — server side ---------------------------------------------------
# Region for staging and production projects: ap-south-1 (Mumbai). See docs/DECISIONS.md D-001.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # API only. Never in apps/web. Never in workers for tenant reads.
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_REF=

# --- Supabase — browser side --------------------------------------------------
# Only VITE_PUBLIC_* variables are allowed into the web bundle.
VITE_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
VITE_PUBLIC_SUPABASE_ANON_KEY=
VITE_PUBLIC_API_BASE_URL=http://localhost:8787
VITE_PUBLIC_APP_ENV=local

# --- Direct database ----------------------------------------------------------
# Used by Supabase CLI migrations, pgTAP and the drift check only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Workers connect as asap_worker, which does NOT bypass RLS.
# The role is created by migration 0013 with no password; set one per environment with
#   pnpm db:worker-password
# See docs/PHASE-1-SCHEMA.md migration 0013 and docs/DECISIONS.md D-006.
WORKER_DATABASE_URL=postgresql://asap_worker:CHANGE_ME@127.0.0.1:54322/postgres
WORKER_DB_PASSWORD=CHANGE_ME

# --- AI gateway — Phase 5 -----------------------------------------------------
# Model-agnostic by rule. At least one provider must be configured from Phase 5.
# Which adapter serves Ask. `openai` is the first production adapter; `anthropic` is a sibling
# adapter and one config value away; `fake` is deterministic and is what the tests run against.
# With none configured, Ask returns its configuration-required state rather than failing.
AI_DEFAULT_PROVIDER=openai            # openai | anthropic | fake
AI_MODEL=                             # the exact model Ask uses. Never hardcoded in the code.
AI_FAST_MODEL=                        # routing, classification, chunk contextualisation, re-ranking
AI_FRONTIER_MODEL=                    # interpretation, drafting, comparison, cited answers
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=
AI_MAX_TOKENS=4096
AI_REQUEST_TIMEOUT_MS=60000

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Email: inbound (brokerage mailboxes) — Phase 2 --------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/auth/google/callback      # REAL-DOMAIN in staging/production

MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8787/auth/microsoft/callback  # REAL-DOMAIN in staging/production

# --- Email: outbound (platform transactional) --------------------------------
# Invitations, password resets, system notices. Not client or insurer mail.
# Optional. Absent → email disabled with a startup log line (D-046). Set both or neither.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@asap.example                                    # REAL-DOMAIN

# --- Document extractor (Python service) — Phase 3 ---------------------------
EXTRACTOR_URL=http://localhost:8000
EXTRACTOR_SHARED_SECRET=              # service-to-service auth, rotate quarterly

# --- Storage ------------------------------------------------------------------
STORAGE_BUCKET=insurance-documents
SIGNED_URL_TTL_SECONDS=300            # keep short; documents are client-confidential. Schema caps at 3600.
MAX_UPLOAD_BYTES=52428800             # 50 MB

# --- Security -----------------------------------------------------------------
ENCRYPTION_KEY=                       # >= 32 chars. `openssl rand -base64 32`, or let Render generate it. Back it up the day it is created.
INVITATION_TOKEN_TTL_HOURS=168        # 7 days
SESSION_IDLE_TIMEOUT_MINUTES=480
PASSWORD_MIN_LENGTH=12                # Mirrors supabase/config.toml auth.minimum_password_length. See D-005.

# --- Monitoring ---------------------------------------------------------------
# SENTRY_DSN required when APP_ENV is staging or production.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
VITE_PUBLIC_SENTRY_DSN=
POSTHOG_API_KEY=
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# --- Feature flags ------------------------------------------------------------
FEATURE_AI_ENABLED=false              # Phase 5
FEATURE_AUTOMATIONS_ENABLED=false     # Phase 12
FEATURE_EXTERNAL_SEND_ENABLED=false   # Phase 6 — keep false until the approval engine ships
