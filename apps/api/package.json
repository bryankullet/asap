{
  "name": "@asap/api",
  "version": "0.1.0",
  "private": true,
  "description": "Hono API — AI gateway, intent router, skills, REST. Resolves organization and role server-side from the session.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "eval:ask": "vitest run test/evaluation"
  },
  "dependencies": {
    "@asap/schema": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.115.0",
    "hono": "^4.13.7",
    "pino": "^10.3.1",
    "read-excel-file": "^9.3.10",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
